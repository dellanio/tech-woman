# Sourced by deploy.sh from its own root-owned directory; part of the hashed ops package.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
TW_LOCK_FILE=/var/lock/tech-woman-deploy.lock
TW_STATE_DIR=/var/lib/tech-woman-cutover
TW_APP_DIR=/var/www/tech-woman
TW_PYTHON=/usr/bin/python3
TW_STATE_OWNER_UID=0
TW_STATE_MODE_CHECK=1
TW_ENV_DIR=/var/www/tech-woman/env
TW_BASH=/bin/bash
TW_DB_FILE=/var/www/tech-woman/dados/tech-woman.db
TW_NETWORK=dellaniocom_default
TW_BACKUP_DIR=/var/www/tech-woman/backups
TW_PG_CONTAINER=postgres
TW_PG_DB=techwoman
TW_PG_DUMP_USER=backup_techwoman
TW_PG_ADMIN_USER=postgres
TW_SMOKE_ATTEMPTS=45
TW_SMOKE_DELAY=2
TW_CRON_PATHS=/etc/crontab,/etc/cron.d,/etc/cron.hourly,/etc/cron.daily,/etc/cron.weekly,/etc/cron.monthly,/var/spool/cron/crontabs
