# Somente ambiente local sintético. Gere valores exclusivos; não copie segredos do host.
POSTGRES_PASSWORD=replace-bootstrap-random
MIGRATOR_PASSWORD=replace-migrator-random
RUNTIME_PASSWORD=replace-runtime-random
MAILER_PASSWORD=replace-mailer-random
DATABASE_URL=postgresql://techwoman_runtime:replace-runtime-random@127.0.0.1:55432/techwoman
MIGRATION_DATABASE_URL=postgresql://techwoman_migrator:replace-migrator-random@127.0.0.1:55432/techwoman
MAILER_DATABASE_URL=postgresql://techwoman_mailer:replace-mailer-random@127.0.0.1:55432/techwoman
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-64-random-hex-characters
ADMIN_EMAIL=admin-local@example.invalid
ADMIN_PASSWORD=replace-with-exclusive-local-password
LOCAL_SEED=1
EMAIL_MODE=fake
SES_SEND_ENABLED=0
SES_IDENTITY_VERIFIED=0
SES_IAM_AUTHORIZED=0
SES_ACCOUNT_PRODUCTION=0
SES_REGION=us-east-1
SES_FROM=
MENTOR_DEADLINE=2026-10-31T02:59:59.999Z
NEXT_TELEMETRY_DISABLED=1
# O processo web recebe só DATABASE_URL; migrador/seed/worker são processos distintos.
# TRUST_PROXY=1 só atrás do proxy configurado, que sobrescreve o último salto X-Forwarded-For.
# Produção exige configuração explícita; acesso direto local mantém 0.
TRUST_PROXY=0
RATE_LIMIT_SECRET=replace-with-independent-random-at-least-32-characters
RATE_LOGIN_PAIR_PER_MIN=5
RATE_LOGIN_IP_PER_MIN=30
RATE_EMAIL_PER_HOUR=3
RATE_IP_PER_HOUR=20
RATE_RESET_IP_PER_MIN=10
# Vazia bloqueia SES; preencher só pelo operador com destinatário aprovado.
SES_RECIPIENT_ALLOWLIST=
